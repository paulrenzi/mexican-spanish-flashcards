[Unit]
Description=mx-voice origin: Parakeet speech-to-text + claude -p translation on the Max plan
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/repos/mexican-spanish-flashcards/voice/origin
EnvironmentFile=/home/ubuntu/.config/mx-voice/origin.env
Environment=PATH=/home/ubuntu/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/repos/mexican-spanish-flashcards/voice/origin/.venv/bin/python server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
